# Copy to .env for local development. Never commit .env.
# In staging/production set these as platform secrets (Render env groups, AWS Secrets Manager, ...).

ENVIRONMENT=development          # development | test | staging | production
DEBUG=true                       # pretty console logs; false = JSON logs

DATABASE_URL=postgresql+asyncpg://hsc:hsc@127.0.0.1:5432/hsc
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_PGBOUNCER=false                # true for Supabase :6543 / Neon -pooler URLs
REDIS_URL=redis://127.0.0.1:6379/0
RUN_WORKER_IN_API=false          # true = run background jobs inside the API (no separate worker)

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Required (>=32 chars) in staging/production; the app refuses to boot otherwise.
JWT_SECRET=dev-only-change-me-dev-only-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

CORS_ORIGINS=["http://localhost:3000"]
FRONTEND_URL=http://localhost:3000

SENTRY_DSN=

# Media storage (Cloudinary). Leave empty and image upload returns 503; everything else works.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MEDIA_FOLDER=hsc-dev

INVENTORY_HOLD_SECONDS=900       # how long checkout holds stock while awaiting payment

# Pricing policy — business decisions, confirm with your accountant before launch
PRICES_INCLUDE_TAX=true          # listed prices are GST-inclusive
TAX_RATE_BPS=1800                # 18.00%
SHIPPING_FLAT_PAISE=9900         # ₹99
FREE_SHIPPING_THRESHOLD_PAISE=99900   # free shipping from ₹999 (after discount)
MAX_CART_ITEM_QUANTITY=20
MAX_CART_LINES=50
RETURN_WINDOW_DAYS=7

# Email over SMTP — any provider (SES, Brevo, Resend, Zoho, Gmail). Empty = emails are logged (dev only).
SMTP_HOST=
SMTP_PORT=587                    # 587 STARTTLS, 465 implicit TLS
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM="The Hot Smoothie Co. <hello@thehotsmoothie.co>"

# Payments: "dev" simulates the gateway locally (checkout shows a test-payment step).
# Use "razorpay" with real keys in staging/production (dev is refused in production).
PAYMENTS_PROVIDER=dev

# Payments — Razorpay (Dashboard -> Settings -> API Keys / Webhooks). Empty = payment endpoints 503.
# Webhook URL: https://<api-host>/api/v1/webhooks/razorpay
# Events: payment.captured, payment.authorized, payment.failed, order.paid, refund.processed, refund.failed
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shipping — Shiprocket (use an API user, not your login). Empty = shipping endpoints 503.
# Tracking webhook URL: https://<api-host>/api/v1/webhooks/shipping, token = SHIPPING_WEBHOOK_TOKEN
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPPING_WEBHOOK_TOKEN=
WAREHOUSE_PINCODE=110001
DEFAULT_ITEM_WEIGHT_GRAMS=250
# Real client IP behind proxies (rate limits, audit log). Never trust X-Forwarded-For blindly.
CLIENT_IP_HEADER=                # cf-connecting-ip when behind Cloudflare
TRUSTED_PROXY_HOPS=0             # 1 behind a single load balancer without Cloudflare
# Shared with the Next.js server (same value as its BFF_SECRET): lets it forward visitor IPs.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
BFF_SECRET=dev-bff-secret-change-me

# Serverless hosts only (Vercel): bearer token for GET /internal/cron (see README)
CRON_SECRET=
